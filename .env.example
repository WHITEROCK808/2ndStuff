# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATA_DIR: Persistent data directory. Zeabur must mount a Volume at /data.
DATA_DIR="/data"

# ADMIN_PASSCODE: The secure admin passcode for Bob's Private Vault.
# Change this on production/github without revealing it in source-controlled front-end files.
ADMIN_PASSCODE=

# ADMIN_TOTP_SECRET: Optional Base32 Google Authenticator Secret (e.g. "JBSWY3DPEHPK3PXP", 16-character A-Z 2-7) 
# If set, you can also log in as administrator using 6-digit dynamic TOTP tokens!
ADMIN_TOTP_SECRET=

# ADMIN_SESSION_SECRET: Signs the HttpOnly admin session cookie.
# Use a long random value in production. If omitted, the server derives one from the admin credentials.
ADMIN_SESSION_SECRET=

# SMTP Server Credentials for the contact email engine.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="your-authorized-gmail-address@gmail.com"
SMTP_PASS="your-gmail-app-password"
SMTP_TARGET_EMAIL="your-target-email@gmail.com"

